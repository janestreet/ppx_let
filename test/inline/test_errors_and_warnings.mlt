let no_let_rec =
  let%bind rec x = Some 4 in
  ()
;;

[%%expect
  {|
Line _, characters _-_:
Error: 'let%bind' may not be recursive
|}]

let no_let_mutable =
  let%bind mutable x = Some 4 in
  ()
;;

[%%expect
  {|
Line _, characters _-_:
Error: 'let%bind' may not be mutable
|}]

let no_if_bind_else = if%bind Some true then Some ()

[%%expect
  {|
Line _, characters _-_:
Error: 'if%bind' must include an else branch
|}]
